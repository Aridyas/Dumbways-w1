<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-gray-300">

<header>
    <nav class="flex flex-row justify-between w-full h-auto py-4 px-8 bg-white">
        <div class="flex justify-center items-center gap-2 ">
            <i data-lucide="hexagon"></i>
            <h2 class="text-xl">HEXAGON</h2>
        </div>
    </nav>
</header>

<main class="flex w-screen min-h-screen">

    <!--form-->
    <div class="flex justify-center items-center flex-1 p-24">
        <div class="bg-white p-12 rounded-3xl w-full max-w-lg flex flex-col items-center">

            <h2 class="text-3xl mb-8">REGISTER</h2>

            <form id="registerForm" action="/user/register" 
                method="post"
                class="flex flex-col gap-6 w-full"
            >
                <div>
                    <label>Name</label>
                    <input id="name" type="text" name="name" class="w-full p-2 rounded-xl bg-gray-200 shadow-sm shadow-black/50" />
                </div>

                <div>
                    <label>Email</label>
                    <input id="email" type="email" name="email" class="w-full p-2 rounded-xl bg-gray-200 shadow-sm shadow-black/50" />
                </div>

                <div>
                    <label>Password</label>
                    <input id="password" type="password" name="password" class="w-full p-2 rounded-xl bg-gray-200 shadow-sm shadow-black/50" />
                </div>
                <button type="submit" class="py-2 bg-gray-200 w-full rounded-full shadow-sm shadow-black/50">Register</button>
            </form>
        </div>
    </div>

</main>

<script src="https://unpkg.com/lucide@latest"></script>

</body>
</html>
