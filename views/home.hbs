<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-gray-300">

<header>
    <nav class="flex flex-row justify-between w-full h-auto py-4 px-8 bg-white">
        <div class="flex justify-center items-center gap-2 ">
            <i data-lucide="hexagon"></i>
            <h2 class="text-xl">HEXAGON</h2>
        </div>
        <div>
            <button onclick="location.href='/account/{{user.id}}'" class="flex-1 bg-black rounded-full text-white py-2 px-5">Account</button>
        </div>
    </nav>
</header>

<main class="flex flex-col w-screen min-h-screen p-10 gap-5">
    <div class="flex items-center flex-col bg-white w-full rounded-2xl p-10 gap-5">
        <h2 class="text-4xl">Public Projects</h2>
        <div class="flex flex-col w-full p-2 bg-gray-200 rounded-md shadow-sm shadow-black/40">
            <p>Include Techs</p> 
            <div class="flex flex-row w-full gap-5">
                <label>Node.js <input name="node" type="radio"/></label>
                <label>Next.js <input name="next" type="radio"/></label>
                <label>Reac t<input name="react" type="radio"/></label>
                <label>TypeScript <input name="ts" type="radio"/></label>
            </div>
        </div>
        <div class="flex flex-col w-full p-2 bg-gray-200 rounded-md shadow-sm shadow-black/40">
            <p>Exclude Techs</p>
            <div class="flex flex-row w-full gap-5"> 
                <label>Node.js <input name="node" type="radio"/></label>
                <label>Next.js <input name="next" type="radio"/></label>
                <label>React <input name="react" type="radio"/></label>
                <label>TypeScript <input name="ts" type="radio"/></label>
            </div>
        </div>
        <div class="flex w-full">
            <button class="flex py-2 px-8 bg-gray-200 rounded-full shadow-sm shadow-black/40">Filter</button>
        </div>
    </div>
    <div class="flex items-center flex-col bg-white w-full rounded-2xl p-10 gap-5">
        <div class="flex grid grid-cols-5 grid-flow-row flex-row gap-3">
            {{#each projects}}
                <div class="flex flex-col bg-white shadow-md shadow-black/40 p-3 rounded-xl gap-2 text-sm w-60 h-80">
                    {{#if image}}
                        <img src="{{this.image}}" class="w-full h-40 object-cover overflow-hidden rounded-lg">
                    {{else}}
                        <div class="flex w-full h-40 justify-center items-center object-cover rounded-lg bg-gray-200">
                            <h2 class="text-gray-600">No image provided</h2>
                        </div>
                    {{/if}}

                    <div class="flex flex-col">
                        <p class="text-lg font-bold truncate">{{this.name}}</p>
                        <p class="text-md font-bold truncate text-gray-400">@{{this.user.name}}</p>
                    </div>

                    <div class="flex flex-row flex-wrap gap-1">
                        {{#each this.techs}}
                            <div class="p-1 bg-gray-200 rounded shadow-sm shadow-black/40"><i data-lucide="{{this}}"></i></div>
                        {{/each}}
                    </div>

                    <p class="text-xs text-gray-600">Start: {{this.startFormatted}} End: {{this.endFormatted}}</p>

                    <button onclick="location.href='/project/{{this.id}}'" class="flex-1 bg-black rounded-xl text-white p-2">Details</button>
                </div>
            {{/each}}
        </div>
    </div>
</main>

<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>
</body>
</html>
